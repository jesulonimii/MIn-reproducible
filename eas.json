{
  "cli": {
    "version": ">= 0.52.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
        "android": {
            "buildType": "app-bundle"
        }
    },
    "development:simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "channel": "staging",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
      }
    },
    "development:simulator": {

    }
  }
}
