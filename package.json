  "main": "index.js",
  "scripts": {
    "start": "expo start --port 9200",
    "start:offline": "expo start --port 9200 --offline",
    "start:no-cache": "expo start --clear --port 9200",
    "start:server": "cd ../youface-server && npm run start:dev",
    "config:versioncode": "eas build:version:set",
    "update:staging": "NODE_ENV=test eas update --branch staging",
    "build:android:dev": "NODE_ENV=development eas build -p android --profile development",
    "build:android:staging": "NODE_ENV=test eas build -p android --profile staging",
    "build:android:production": "NODE_ENV=production eas build -p android --profile production",
    "update:android:production": "NODE_ENV=production eas update --branch production-android",
    "build:ios:dev:simulator": "NODE_ENV=development eas build -p ios --profile development:simulator --auto-submit",
    "build:ios:dev": "NODE_ENV=development eas build -p ios --profile development",
    "build:ios:staging": "NODE_ENV=test eas build -p ios --profile staging --auto-submit",
    "build:ios:production": "NODE_ENV=production eas build -p ios --profile production",
    "update:ios:production": "NODE_ENV=production eas update --branch production"
  },

